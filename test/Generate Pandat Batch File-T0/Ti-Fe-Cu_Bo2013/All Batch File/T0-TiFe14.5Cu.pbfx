<pbfx version="1.0" encoding="utf-8">
  <Header copyright="CompuTherm, LLC">
    <!-- this file defines the syntax for a batch calculation -->
    <Application name="Pandat" version="2025" />
  </Header>
  <calculation name="T0_TIFE14.5CU" type="section" duration=" " original_batch_name="" id=" ">
    <databases>
      <database type="tdb" file_name="Ti-Fe-Cu_Bo2013.TDB" />
    </databases>
    <units>
      <unit name="P" value="bar" />
      <unit name="T" value="K" />
      <unit name="n" value="w%" />
    </units>
    <system name="Default_System">
      <components>
        <component name="CU" status="Selected" />
        <component name="FE" status="Selected" />
        <component name="TI" status="Selected" />
      </components>
      <phases>
        <phase name="*" status="Entered" />
      </phases>
      <points>
        <point>
          <statespace>
            <T value="2000" />
            <P value="1" />
            <n component="CU" value="14.5" />
            <n component="FE" value="0" />
            <n component="TI" value="85.5" />
          </statespace>
        </point>
        <point>
          <statespace>
            <T value="300" />
            <P value="1" />
            <n component="CU" value="14.5" />
            <n component="FE" value="0" />
            <n component="TI" value="85.5" />
          </statespace>
        </point>
        <point>
          <statespace>
            <T value="300" />
            <P value="1" />
            <n component="CU" value="14.5" />
            <n component="FE" value="30" />
            <n component="TI" value=" " />
          </statespace>
        </point>
      </points>
      <condition>
        <extensive_search value="true" />
        <equilibrium_type type="global" />
        <contour name="Contour_T0" property="T0" step="0.1">
          <constraint name="phase_name=BCC_A2+LIQUID" />
        </contour>
        <scanline_density value="4" />
      </condition>
    </system>
    <output unit="">
      <tables>
        <table name="T0_TIFE14.5CU" source="Contour_T0" type="Contour">
          <column name="T" />
          <column name="phase_name" />
          <column name="x(*)" />
          <column name="w(*)" />
        </table>
      </tables>
      <graphs>
        <graph name="T0_TIFE14.5CU">
          <plot table_name="T0_TIFE14.5CU" xaxis="w(FE)" yaxis="T" />
        </graph>
      </graphs>
    </output>
  </calculation>
</pbfx>