<pbfx>
  <calculation name="T0_ALCU%SI%SI" type="section" duration="8.5" original_batch_name="" id="3">
    <databases>
      <database type="tdb" file_name="Al-Cu-Si_COST.tdb" />
    </databases>
    <units>
      <unit name="P" value="bar" />
      <unit name="T" value="K" />
      <unit name="n" value="w%" />
    </units>
    <system name="Default_System">
      <components>
        <component name="AL" status="Selected" />
        <component name="CU" status="Selected" />
        <component name="SI" status="Selected" />
      </components>
      <phases>
        <phase name="*" status="Suspended" />
        <phase name="LIQUID" status="Entered" />
        <phase name="FCC_A1" status="Entered" />
      </phases>
      <points>
        <point>
          <statespace>
            <T value="1500" />
            <P value="1" />
            <n component="AL" value="%AL%" />
            <n component="CU" value="0" />
            <n component="SI" value="%SI%" />
          </statespace>
        </point>
        <point>
          <statespace>
            <T value="300" />
            <P value="1" />
            <n component="AL" value="%AL%" />
            <n component="CU" value="0" />
            <n component="SI" value="%SI%" />
          </statespace>
        </point>
        <point>
          <statespace>
            <T value="300" />
            <P value="1" />
            <n component="AL" value=" " />
            <n component="CU" value="40" />
            <n component="SI" value="%SI%" />
          </statespace>
        </point>
      </points>
      <condition>
        <equilibrium_type type="global" />
        <contour name="Contour_T0" property="T0" step="0.1">
          <constraint name="phase_name=LIQUID+*" />
        </contour>
      </condition>
    </system>
    <output unit="">
      <tables>
        <table name="T0_ALCU%SI%SI" source="Contour_T0" type="Contour">
          <column name="T" />
          <column name="phase_name" />
          <column name="w(*)" />
          <column name="x(*)" />
        </table>
      </tables>
      <graphs>
        <graph name="T0_ALCU%SI%SI">
          <plot table_name="T0_ALCU%SI%SI" xaxis="w(CU)" yaxis="T" />
        </graph>
      </graphs>
    </output>
  </calculation>
</pbfx>