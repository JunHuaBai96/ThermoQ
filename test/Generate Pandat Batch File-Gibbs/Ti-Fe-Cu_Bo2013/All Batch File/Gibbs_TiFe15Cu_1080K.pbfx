  </Header>
  <calculation name="Gibbs_TIFE15CU_1080K" type="line" duration=" " original_batch_name="" id="0">
    <databases>
      <database type="tdb" file_name="Ti-Fe-Cu_Bo2013.TDB" />
    </databases>
    <units>
      <unit name="P" value="bar" />
      <unit name="T" value="K" />
      <unit name="n" value="w%" />
