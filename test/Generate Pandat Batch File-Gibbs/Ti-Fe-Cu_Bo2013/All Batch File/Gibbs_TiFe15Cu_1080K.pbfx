    <system name="Default_System">
      <components>
        <component name="CU" status="Selected" />
        <component name="FE" status="Selected" />
        <component name="TI" status="Selected" />
      </components>
      <phases>
        <phase name="*" status="Suspended" />
        <phase name="LIQUID" status="Entered" />
        <phase name="BCC_A2" status="Entered" />    
      </phases>
      <points>
        <point>
          <statespace>
            <T value="1080" />
            <P value="1" />
            <n component="TI" value="85" />
            <n component="FE" value="0" />
            <n component="CU" value="15" />
          </statespace>
        </point>
        <point>
          <statespace>
            <T value="1080" />
            <P value="1" />
            <n component="TI" value="  " />
            <n component="FE" value="40" />
            <n component="CU" value="15" />
          </statespace>
        </point>
      </points>
      <condition>
        <extensive_search value="true" />
        <equilibrium_type type="global" />
        <steps value="100" />
